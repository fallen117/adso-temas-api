# Contexto de build = temas-api/

# Dependencias: las reinstala "npm ci" dentro de la imagen. Si las copiaras,
# estarian compiladas para Windows y noarian en Alpine.
node_modules

# Artefactos de compilacion: se regeneran con "npm run build" en la imagen.
dist
*.tsbuildinfo

# Secretos. llegan por "env_file" en el compose, nunca en una capa de la imagen.
.env
.env.*
!.env.example

# Nada de esto se usa en tiempo de ejecucion.
.git
.gitignore
.gitattributes
Dockerfile
.dockerignore
README.MD
Dockerfile*
*.log
*.md
