# -----------------------------------------------------------------------------
#  Copia este archivo a ".env" y reemplaza los valores de ejemplo.
#     copy .env.example .env      (PowerShell)   |   cp .env.example .env  (bash)
#  ".env" esta en .gitignore, nunca lo subas al repositorio.
# -----------------------------------------------------------------------------

# --- Supabase PostgreSQL -----------------------------------------------------
# Usa SIEMPRE el "Pooler" de Supabase (Connection string -> URI), no la
# conexion directa: la directa solo resuelve IPv6 y la mayoria de los
# entornos Docker / redes domesticas no tienen IPv6.
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.tu_project_ref
DB_PASSWORD=cambia_esto_por_tu_password_de_supabase

# Esquema donde viven las tablas. La entidad lo fija en @Entity({ schema: 'sena' })
DB_SCHEMA=sena

# --- Google Gemini (generacion de tips) --------------------------------------
# Si la dejas vacia el POST /temas sigue funcionando, pero el tema se guarda
# sin tips: el service atrapa el error y lo baja a un log "warn".
GEMINI_API_KEY=

# --- Runtime -----------------------------------------------------------------
# development = habilita el log de consultas SQL de TypeORM
NODE_ENV=development

# Puerto interno del contenedor. El host lo publica con "3000:3000" en compose.
PORT=3000
